{
  "name": "imessage-wrapped",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Smit Patel",
  "repository": {
    "type": "git",
    "url": "https://github.com/smitsp11/imessage-wrapped.git"
  },
  "homepage": "https://github.com/smitsp11/imessage-wrapped#readme",
  "bugs": {
    "url": "https://github.com/smitsp11/imessage-wrapped/issues"
  },
  "keywords": ["imessage", "wrapped", "macos", "typescript", "sqlite"],
  "type": "module",
  "description": "Spotify Wrapped for your iMessage group chats. Runs locally on your Mac.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wrapped": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "demo:json": "TZ=UTC tsx src/cli.ts demo --out web/public/demo.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
